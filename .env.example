# XG-CLI 配置示例：复制为 .env 并填入真实值

# ===== 选择使用哪个 base provider（主对话默认，必配） =====
# 无内置 provider。所有服务商都必须在 config.json 的 providers 节中定义
# （name / api_base / default_model），然后在此选择用哪一个作为 base。
XG_PROVIDER=<你的 provider 名称>

# ===== 各 provider 的 API Key（必配） =====
# 每个 provider 的 Key 经 XG_<NAME>_API_KEY 提供；占位值（如 sk-xxx）会被忽略，视为未配置。
# api_base 与 default_model 在 config.json 的 providers 中配置（api_base 也可用 XG_<NAME>_API_BASE 覆盖）。
XG_MY_PROVIDER_API_KEY=sk-xxx

# ===== 可选覆盖 =====
# 默认模型（未配置 active_model 时生效）
XG_MODEL=gpt-4o-mini
# 上下文窗口大小（token），用于预算控制；不设则取 provider 能力声明
XG_CONTEXT_WINDOW=128000
# 自动压缩输入预算比例（0.5~0.9，默认 0.8）
XG_CONTEXT_BUDGET_RATIO=0.8
# 自动压缩时保留的最近完整对话轮次
XG_CONTEXT_KEEP_RECENT_TURNS=4
# 摘要输出动态预留上限
XG_CONTEXT_SUMMARY_MAX_TOKENS=4096
# 自动注入长期记忆的字符上限
XG_MEMORY_PROMPT_MAX_CHARS=8000
# 单个 XG.md/XG.local.md 的读取字符上限
XG_PROJECT_MEMORY_MAX_CHARS=32000
# 单轮工具调用步数上限
XG_TOOL_STEPS=20
# 并行工具执行并发数（默认 4）
XG_MAX_PARALLEL=4
# 单工具执行超时（秒，默认 120）
XG_TOOL_TIMEOUT=120
# HITL 危险操作审批（on 默认开启；off = 危险模式，不弹审批）
XG_HITL=on

# ===== 计划模式 /plan =====
# 拆解子任务数上限（默认 12）
XG_PLAN_MAX_SUBTASKS=12
# 每个子任务的最大工具步数（默认 10）
XG_PLAN_SUBTASK_STEPS=10
# 计划级允许的子任务失败数，超出终止剩余批次（默认 3）
XG_PLAN_MAX_FAILURES=3

# ===== Multi-Agent Team /team =====
# 同时运行的 Worker 数量上限（默认 4）
XG_TEAM_MAX_AGENTS=4
# 单个任务的定向 Repair 次数上限（默认 2）
XG_TEAM_MAX_REPAIRS=2
# Team 任务级证据审查（on 默认开启）
XG_TEAM_REVIEW=on

# ===== MCP 客户端 =====
# MCP 总开关（on 默认开启；没有 mcp.json 时不启动任何 Server）
XG_MCP_ENABLED=on
# Server 初始化 / 单请求 / 关闭超时（秒）
XG_MCP_STARTUP_TIMEOUT=15
XG_MCP_REQUEST_TIMEOUT=120
XG_MCP_SHUTDOWN_TIMEOUT=5
# Server、工具、resources 和协议消息限制
XG_MCP_MAX_SERVERS=32
XG_MCP_MAX_TOOLS=256
XG_MCP_MAX_RESOURCES=512
XG_MCP_MAX_MESSAGE_BYTES=2097152
# 单 resource 与单次用户输入引用的总字符上限
XG_MCP_RESOURCE_MAX_CHARS=32000
XG_MCP_RESOURCE_TOTAL_CHARS=64000
# 每个 Server 保留的最近日志行数
XG_MCP_LOG_LINES=200

# ===== Web 只读联网能力=====
# Web 总开关；off 时不注册 web_search / web_fetch
XG_WEB_ENABLED=on
# zhipu / serpapi / searxng / none（none 时搜索不可用，但不影响抓取）
XG_WEB_SEARCH_PROVIDER=none
XG_ZHIPU_SEARCH_API_BASE=
XG_ZHIPU_SEARCH_API_KEY=
XG_SERPAPI_API_BASE=https://serpapi.com
XG_SERPAPI_API_KEY=
XG_SEARXNG_URL=
XG_WEB_TIMEOUT=15
XG_WEB_MAX_RESULTS=5
XG_WEB_MAX_RESPONSE_BYTES=2097152
XG_WEB_FETCH_MAX_CHARS=32000
XG_WEB_MAX_REDIRECTS=5
XG_WEB_RATE_LIMIT_PER_MINUTE=30

# ===== Skill 技能系统 =====
# Skill 总开关；off 时不注入 Skill 索引，也不注册 load_skill
XG_SKILLS_ENABLED=on
# 启动索引和按需加载限制
XG_SKILLS_MAX_INDEX_ITEMS=20
XG_SKILLS_MAX_INDEX_CHARS=4096
XG_SKILLS_MAX_CHARS=32000
XG_SKILLS_MAX_REFERENCE_CHARS=16000
XG_SKILLS_MAX_LOADED_CHARS=64000

# ===== Composer 输入历史 =====
# 总开关；off 时上下键不会浏览历史
XG_INPUT_HISTORY_ENABLED=on
# 是否持久化非敏感输入（敏感输入默认不会落盘）
XG_INPUT_HISTORY_PERSIST=on
XG_INPUT_HISTORY_MAX_ENTRIES=100
XG_INPUT_HISTORY_MAX_CHARS=8000
XG_INPUT_HISTORY_MAX_BYTES=1048576

# ===== SmartRouter 智能路由 =====
# 自动路由总开关（on 开启；不设/off 时按手动模型运行，与以前一致）
XG_SMART_ROUTER=off
# 四档分别接哪个 provider/model（每档两键 provider + model）
# 键名格式：XG_SMART_ROUTER_<档位大写>_<PROVIDER|MODEL>
# 档位：Basic(闲聊/简单问答) / Enhanced(写函数/改文件) /
#       Superior(重构/排查/多文件) / Ultimate(架构/设计/高风险)
# 优先于 config.json 中 smart_router.tiers 的同名字段；可不配，未配档位回落当前手动模型
XG_SMART_ROUTER_BASIC_PROVIDER=openai
XG_SMART_ROUTER_BASIC_MODEL=gpt-4o-mini
XG_SMART_ROUTER_ENHANCED_PROVIDER=openai
XG_SMART_ROUTER_ENHANCED_MODEL=gpt-4o-mini
XG_SMART_ROUTER_SUPERIOR_PROVIDER=deepseek
XG_SMART_ROUTER_SUPERIOR_MODEL=deepseek-chat
XG_SMART_ROUTER_ULTIMATE_PROVIDER=glm
XG_SMART_ROUTER_ULTIMATE_MODEL=glm-4-plus
