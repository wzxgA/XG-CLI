# XG-CLI 配置示例：复制为 .env 并填入真实值

# ===== 选择使用哪个 provider（必填） =====
# 内置：openai / deepseek / glm / kimi；也可自定义
XG_PROVIDER=openai

# ===== 各 provider 的 URL 与 API Key（按需填写） =====
# 每个 provider 必须配置自己的专属 Key；占位值（如 sk-xxx）会被忽略，视为未配置
XG_OPENAI_API_BASE=https://api.openai.com/v1
XG_OPENAI_API_KEY=sk-xxx
XG_DEEPSEEK_API_BASE=https://api.deepseek.com/v1
XG_DEEPSEEK_API_KEY=sk-xxx
XG_GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
XG_GLM_API_KEY=sk-xxx
XG_KIMI_API_BASE=https://api.moonshot.cn/v1
XG_KIMI_API_KEY=sk-xxx

# ===== 可选覆盖 =====
# 默认模型（未配置 active_model 时生效）
XG_MODEL=gpt-4o-mini
# 上下文窗口大小（token），用于预算控制；不设则取 provider 能力声明
XG_CONTEXT_WINDOW=128000
# 单轮工具调用步数上限
XG_TOOL_STEPS=20
