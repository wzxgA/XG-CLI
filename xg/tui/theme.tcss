Screen {
    background: $surface;
}

#header {
    height: 1;
    color: $text;
    background: $panel;
    padding: 0 1;
}

#header.usage-warning {
    color: $warning;
}

#header.usage-error {
    color: $error;
}

#body {
    height: 1fr;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#inspector {
    width: 36;
    min-width: 32;
    border-left: solid $primary;
    padding: 1;
    color: $text-muted;
}

#inspector-tabs {
    height: 2;
    width: 1fr;
    color: $text-muted;
}

InspectorTab {
    width: 1fr;
    height: 2;
    content-align: center middle;
    padding: 0;
    text-wrap: nowrap;
    overflow: hidden;
}

InspectorTab:hover {
    color: $text;
    background: $panel;
}

InspectorTab.active {
    color: $accent;
    text-style: bold;
    border-bottom: heavy $accent;
}

#inspector-content {
    height: 1fr;
    overflow-y: auto;
}

#inspector-content > Static {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

#notification {
    height: auto;
    max-height: 2;
    padding: 0 1;
    color: $warning;
}

#composer-area {
    dock: bottom;
    height: auto;
    margin: 0 1;
}

#queue-status {
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#command-suggestions {
    width: 1fr;
    height: auto;
    max-height: 8;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    border: round $primary;
    scrollbar-size: 1 1;
}

#command-suggestions > .option-list--option-highlighted {
    color: $text;
    background: $accent;
}

#composer-label {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $panel;
    text-style: bold;
}

#composer {
    height: 3;
    margin: 0;
    border: round $primary;
    background: $surface;
}

#composer:focus {
    border: double $accent;
}

#footer {
    height: 1;
    color: $text-muted;
    background: $panel;
    padding: 0 1;
}

ApprovalModal, PlanModal {
    align: center middle;
}

#approval-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#confirm-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}
