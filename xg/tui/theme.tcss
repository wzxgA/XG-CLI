Screen {
    background: $surface;
}

#header {
    height: 1;
    color: $text;
    background: $panel;
    padding: 0 1;
}

#body {
    height: 1fr;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#inspector {
    width: 28;
    min-width: 24;
    border-left: solid $primary;
    padding: 1;
    color: $text-muted;
}

#notification {
    height: auto;
    max-height: 2;
    padding: 0 1;
    color: $warning;
}

#composer-area {
    dock: bottom;
    height: auto;
    margin: 0 1;
}

#queue-status {
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#command-suggestions {
    width: 1fr;
    height: auto;
    max-height: 8;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    border: round $primary;
    scrollbar-size: 1 1;
}

#command-suggestions > .option-list--option-highlighted {
    color: $text;
    background: $accent;
}

#composer-label {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $panel;
    text-style: bold;
}

#composer {
    height: 3;
    margin: 0;
    border: round $primary;
    background: $surface;
}

#composer:focus {
    border: double $accent;
}

#footer {
    height: 1;
    color: $text-muted;
    background: $panel;
    padding: 0 1;
}

ApprovalModal, PlanModal {
    align: center middle;
}

#approval-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#confirm-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}
